<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_app"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/titulo_editor_xml"
        android:textColor="@color/texto_principal"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/xml_nome_arquivo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="middle"
        android:maxLines="1"
        android:text="@string/nenhum_xml"
        android:textColor="@color/texto_secundario"
        android:textSize="13sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/xml_abrir_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/abrir_xml" />

            <Button
                android:id="@+id/xml_desfazer_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/desfazer" />

            <Button
                android:id="@+id/xml_refazer_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/refazer" />
        </LinearLayout>
    </HorizontalScrollView>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/xml_formatar_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/formatar_xml" />

            <Button
                android:id="@+id/xml_validar_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/validar_xml" />

            <Button
                android:id="@+id/xml_salvar_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/salvar_como" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/xml_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:accessibilityLiveRegion="polite"
        android:text="@string/estado_editor_pronto"
        android:textColor="@color/texto_secundario"
        android:textSize="13sp" />

    <ScrollView
        android:id="@+id/xml_scroll_vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@color/fundo_conteudo"
        android:fillViewport="true">

        <HorizontalScrollView
            android:id="@+id/xml_scroll_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="horizontal|none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/xml_line_numbers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/xml_gutter"
                    android:fontFamily="monospace"
                    android:gravity="top|end"
                    android:includeFontPadding="false"
                    android:minWidth="48dp"
                    android:paddingStart="8dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="12dp"
                    android:text="1"
                    android:textColor="@color/xml_linha"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/xml_codigo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:fontFamily="monospace"
                    android:gravity="top|start"
                    android:hint="@string/dica_editor_xml"
                    android:includeFontPadding="false"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:minWidth="320dp"
                    android:paddingStart="8dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
                    android:scrollHorizontally="true"
                    android:textColor="@color/texto_principal"
                    android:textSize="14sp"
                    android:textIsSelectable="true" />
            </LinearLayout>
        </HorizontalScrollView>
    </ScrollView>

    <ProgressBar
        android:id="@+id/xml_progresso"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />
</LinearLayout>
